# Production .env for the API. Copy to /var/www/inventory-api/.env and fill in every
# value marked CHANGE. Keep a copy in a password manager: backups do not include it.

APP_NAME="Inventory"
APP_ENV=production
APP_KEY=                                  # php artisan key:generate --force
APP_DEBUG=false
APP_URL=https://api.example.com           # CHANGE

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventory
DB_USERNAME=inventory
DB_PASSWORD=                              # CHANGE: the MySQL password you created

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.example.com               # CHANGE: the shared parent domain, with the dot
SESSION_SECURE_COOKIE=true

# The web app's address: CORS and cookie login accept only this origin.
FRONTEND_URL=https://app.example.com      # CHANGE

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Mail is only used for backup and verify alerts. Any SMTP provider works.
MAIL_MAILER=smtp
MAIL_HOST=                                # CHANGE
MAIL_PORT=587
MAIL_USERNAME=                            # CHANGE
MAIL_PASSWORD=                            # CHANGE
MAIL_FROM_ADDRESS="alerts@example.com"    # CHANGE
MAIL_FROM_NAME="${APP_NAME}"

# Starting shop details (edited in the app afterwards). The currency is fixed here.
SHOP_NAME="My Shop"                       # CHANGE
SHOP_ADDRESS=
SHOP_PHONE=
SHOP_EMAIL=
SHOP_TIN=
SHOP_CURRENCY=ETB

# Backups go to the S3-compatible bucket; alerts go to BACKUP_MAIL_TO.
BACKUP_NAME=inventory-api
BACKUP_DISKS=backups
BACKUP_MAIL_TO=you@example.com            # CHANGE
BACKUP_ARCHIVE_PASSWORD=                  # CHANGE: a long random password; keep it safe
BACKUP_S3_KEY=                            # CHANGE
BACKUP_S3_SECRET=                         # CHANGE
BACKUP_S3_REGION=auto                     # B2: e.g. eu-central-003; R2: auto
BACKUP_S3_BUCKET=                         # CHANGE
BACKUP_S3_ENDPOINT=                       # CHANGE: e.g. https://s3.eu-central-003.backblazeb2.com
BACKUP_S3_PATH_STYLE=false

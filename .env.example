APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite for local development. Production uses MySQL/MariaDB:
# set DB_CONNECTION=mysql and fill in the settings below.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Web app (separate repository). CORS allows only this origin, with credentials,
# and Sanctum gives cookie sessions to it (SANCTUM_STATEFUL_DOMAINS defaults to its host:port).
# Production example: FRONTEND_URL=https://app.shop.com, SESSION_DOMAIN=.shop.com, SESSION_SECURE_COOKIE=true
FRONTEND_URL=http://localhost:5173
# SANCTUM_STATEFUL_DOMAINS=app.shop.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Shop details printed on proformas: copied into the database on the first migrate,
# then edited in the app (PATCH /api/v1/shop). The currency stays fixed here.
SHOP_NAME="Demo Building Supplies"
SHOP_ADDRESS=
SHOP_PHONE=
SHOP_EMAIL=
SHOP_TIN=
SHOP_CURRENCY=ETB

# Backups (spatie/laravel-backup): the database and uploaded images, nightly.
# Production: BACKUP_DISKS=backups and fill in the bucket below.
BACKUP_NAME=inventory-api
BACKUP_DISKS=local
BACKUP_MAIL_TO=
BACKUP_ARCHIVE_PASSWORD=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=false
